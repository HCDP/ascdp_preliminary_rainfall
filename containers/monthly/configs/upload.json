{
	"global_cache": "cache.pk",
	"retry": 3,
    "processes": 1,
	"print_exec_stats": true,
	"write_exec_stats": "stats.json",
	"agave_options": {
		"api_server": "https://ikeauth.its.hawaii.edu",
		"username": "username",
		"password": "password",
		"api_key": "api_key",
		"api_secret": "api_secret"
	},
	"upload":
	[
        {
            "local_path": "/workspace/output",
            "remote_path": "HCDP/ASCDP/workflow_data/preliminary/rainfall/outputs/month/%y/%m",
            "system_id": "ikewai-annotated-data"
        },
        {
            "local_path": "/workspace/output/as_idw_rf_month_ras_NRT/as_idw_%y%m.tif",
            "remote_path": "HCDP/ASCDP/production/rainfall/month/data_map/%y",
            "rename": "rainfall_month_data_map_%y_%m.tif",
            "system_id": "ikewai-annotated-data"
        },
        {
            "local_path": "/workspace/output/as_idw_rf_month_meta_NRT/as_idw_meta_%y%m.txt",
            "remote_path": "HCDP/ASCDP/production/rainfall/month/metadata/%y",
            "rename": "rainfall_month_metadata_%y_%m.txt",
            "system_id": "ikewai-annotated-data"
        },
        {
            "local_path": "/workspace/output/as_idw_rf_month_table_NRT/rainfall_month_partial_station_data_%y.csv",
            "remote_path": "HCDP/ASCDP/production/rainfall/month/partial/station_data/%y",
            "rename": "rainfall_month_partial_station_data_%y.csv",
            "system_id": "ikewai-annotated-data"
        }
    ]
}